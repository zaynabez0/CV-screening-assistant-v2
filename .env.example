# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- The API key. Either name works; OPENAI_API_KEY wins if both are set. ---
OPENAI_API_KEY=
# KEY_REGULATOR_API_KEY=

# --- Only if your key goes through a gateway rather than api.openai.com directly. ---
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# --- Only if your gateway exposes the model under a different id. ---
# Defaults to gpt-5.6-luna.
# OPENAI_MODEL=
