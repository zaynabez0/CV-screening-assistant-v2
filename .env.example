# Copy to .env and fill in. .env is gitignored and must never be committed.
KEY_REGULATOR_API_KEY= ..

# Your gateway's endpoint
BASE_URL= ..
# Only if your gateway exposes the model under a different id
AI_MODEL= ..

# Full path to the Tesseract binary. Only needed when it is installed but not on PATH
# — the usual case on Windows.
TESSERACT_CMD= ..

# --- OCR. All optional: the defaults below are what runs if you set none of them. ---

# Turn OCR off entirely (files then need a text layer, as before OCR existed).
# OCR_ENABLED=1

# Tesseract language packs to use, "+"-joined. Each one must be installed; any that
# is not is dropped with a warning rather than failing the file.
# OCR_LANGUAGES=eng+fra

# Render resolution for PDF pages before OCR. 300 is what Tesseract is trained for.
# Lower is faster and noticeably less accurate.
# OCR_DPI=300

# A page with fewer than this many characters of real text is treated as a scan and
# sent to OCR.
# OCR_MIN_CHARS_PER_PAGE=100

# Safety cap on how many pages of one file get OCR'd.
# OCR_MAX_PAGES=30

# Extra Tesseract flags, e.g. --psm 4 for a CV laid out in columns.
# OCR_CONFIG=

# Check every OCR'd page for a sideways/upside-down scan first. Costs one extra pass
# per page; turn it off only if your scans are known to be upright.
# OCR_DETECT_ORIENTATION=1

